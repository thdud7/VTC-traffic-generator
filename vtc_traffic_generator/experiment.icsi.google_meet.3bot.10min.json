  "experiment_id": "icsi-google-meet-3bot-10min",
  "icsi_data": {
    "audio_s3_uri": "s3://vtc-traffic-data/icsi",
    "local_root": "/tmp/vtc-data/icsi",
    "meeting_id": "Bdb001",
    "s3_uri": "s3://vtc-traffic-data/datasets/icsi/v1"
  },
  "media_manifest": {
    "local_path": "vtc_traffic_generator/media.google_meet.test.example.json",
    "media_profile": "test",
    "s3_uri": "s3://${VTC_S3_BUCKET}/${VTC_S3_PREFIX}/media/google_meet/test/manifest.json"
  },
  "media_profile": "test",
  "meet_url": "${VTC_MEET_URL}",
  "repo": {
    "dir": "/home/ubuntu/project/VTC-traffic-generator",
    "python": "python3",
    "url": "https://github.com/thdud7/VTC-traffic-generator.git",
    "version": "meet"
  },
  "run_id": "icsi-google-meet-3bot-10min",
  "service": "google_meet",
  "vtc_url": "${VTC_MEET_URL}",
  "videoconference": true,
  "behavior": {
    "icsi": {
      "audio_warmup_duration_ms": 500,
      "audio_warmup_enabled": true,
      "client_stop_timeout_sec": 180,
      "connect_grace_sec": 5,
      "connect_timeout_sec": 180,
      "corpus_root": "/tmp/vtc-data/icsi",
      "enabled": true,
      "max_duration_sec": 600,
      "meeting_id": "Bdb001",
      "merge_same_bot_gap_ms": 500,
      "mic_action_coalesce_window_ms": 1500,
      "mic_action_timeout_sec": 3.0,
      "mic_pre_roll_sec": 4.0,
      "mic_state_cache_ttl_sec": 10.0,
      "min_safe_gap_for_post_speech_mic_off_sec": 6.0,
      "post_speech_mic_guard_ms": 250,
      "post_speech_mic_off_probability": 0.5,
      "random_seed": 12345,
      "scenario_offset_sec": 0,
      "strict_timing": true,
      "time_scale": 1.0
    },
    "mode": "icsi",
    "random_actions": {
      "camera_probability": 1.0,
      "enabled": true,
      "keep_camera_on": false,
      "max_interval_sec": 35,
      "mic_probability": 0.8,
      "min_interval_sec": 15,
      "nonblocking": true,
      "screen_share_probability": 0.85
    },
    "scenario": {
      "camera_probability": 1.0,
      "enabled": true,
      "keep_camera_on": false,
      "max_interval_sec": 35,
      "mic_probability": 0.8,
      "min_interval_sec": 15,
      "screen_share_probability": 0.85
    }
  }
}
