  "defaults": {
    "adapter_config": {
      "automation_mode": "gui_keyboard",
      "camera_name": "VTC Bot Camera",
      "diagnostic_dir": "/tmp/vtc-{bot_name}/diagnostics",
      "display_backend": "xvfb",
      "failure_postroll_sec": 10,
      "fake_video_capture_dir": "/home/ubuntu/vtc_data/video/fake_camera",
      "fake_video_capture_duration_sec": 30,
      "gui_after_escape_wait_sec": 0.5,
      "gui_join_wait_sec": 15,
      "gui_prejoin_wait_sec": 10,
      "ignore_certificate_errors": true,
      "initial_camera_enabled": true,
      "initial_mic_enabled": true,
      "joined_wait_sec": 45,
      "join_timeout_sec": 60,
      "leave_shortcut": "ctrl+w",
      "locale": "en-US",
      "microphone_name": "VTC_Microphone",
      "page_load_wait_sec": 5,
      "prejoin_camera_off": false,
      "prejoin_mic_off": false,
      "screen_share_shortcut": "ctrl+alt+t",
      "screen_share_confirm_key": "Return",
      "screen_share_post_confirm_wait_sec": 2,
      "screen_share_target": "VTC Share Window",
      "screen_share_target_coordinates": {
        "x": 455,
        "y": 295
      },
      "screen_share_target_select_wait_sec": 0.5,
      "success_postroll_sec": 10,
      "type_delay_ms": 1,
      "use_chrome_fake_camera": true,
      "trust_camera_shortcut_state": true,
      "trust_mic_shortcut_state": true,
      "trust_screen_share_shortcut_state": true,
      "viewport": {
        "height": 720,
        "width": 1280
      }
    },
    "audio_loopback_probe": {
      "duration_sec": 2.5,
      "enabled": true,
      "peak_threshold_db": -50.0,
      "required": true
    },
    "audio_path": "/home/ubuntu/project/VTC-traffic-generator/VTC_AV/VTC_audio_tracks",
    "icsi_audio_root": "/tmp/vtc-data/icsi/ICSI/Signals",
    "packet_capture": {
      "capture_filter": "not port 5900",
      "display_filter": null,
      "dumpcap_path": "dumpcap",
      "enabled": true,
      "filtered_pcapng_enabled": false,
      "interface": "any",
      "output_dir": "/home/ubuntu/vtc_data/captures/local",
      "tshark_path": "tshark"
    },
    "screen_share_window": {
      "enabled": true,
      "html_path": "/home/ubuntu/vtc_data/screen_share/share.html",
      "launch_external": false,
      "open_in_meet_browser": true,
      "title": "VTC Share Window",
      "unique_per_run": false
    },
    "video_name": "bot-placeholder.mp4",
    "video_path": "/home/ubuntu/vtc_data/media/google_meet/test/video",
    "virtual_video": {
      "font_size": 48,
      "fps": 10,
      "height": 360,
      "source": "file",
      "width": 640,
      "y_position": "h-th-24"
    },
