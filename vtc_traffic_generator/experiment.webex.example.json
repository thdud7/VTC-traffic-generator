{
  "service": "webex",
  "vtc_url": "https://example.webex.com/meet/YOUR_ROOM_OR_MEETING_ID",
  "duration": 3,
  "videoconference": true,
  "branch": "webex",
  "run_id": "example-webex-001",
  "repo": {
    "dir": "/home/ubuntu/video-teleconference",
    "url": "git@github.com:YOUR_ORG/video-teleconference.git",
    "version": "webex",
    "python": "python3"
  },
  "ansible": {
    "user": "ubuntu",
    "ssh_private_key_file": "~/.ssh/YOUR_EC2_KEY.pem"
  },
  "capture_upload": {
    "s3_uri": "s3://vtc-traffic-data/captures",
    "run_id": "example-webex-001",
    "include_logs": true
  },
  "defaults": {
    "audio_path": "/home/ubuntu/video-teleconference/VTC_AV/VTC_audio_tracks",
    "voice_name": "male_1-en-US-Wavenet-I",
    "video_path": "/home/ubuntu/video-teleconference/VTC_AV/270_resized",
    "video_name": "man_1_270.mp4",
    "screen_share_window": {
      "enabled": true,
      "title": "VTC Share Window",
      "html_path": "/home/ubuntu/vtc_data/screen_share/share.html",
      "note": "For Webex, title must match the Chrome desktop-capture source shown in the share picker."
    },
    "packet_capture": {
      "enabled": true,
      "interface": "any",
      "output_dir": "/home/ubuntu/vtc_data/captures/local",
      "capture_filter": "not port 5900",
      "display_filter": null,
      "dumpcap_path": "dumpcap",
      "tshark_path": "tshark"
    },
    "adapter_config": {
      "browser_channel": "chrome",
      "auto_select_desktop_capture_source": null,
      "ignore_certificate_errors": true,
      "initial_microphone_enabled": true,
      "initial_camera_enabled": true,
      "apply_initial_media_state_in_prejoin": true,
      "strict_prejoin_media_state": false,
      "fail_on_prejoin_media_state_unverified": false,
      "dismiss_external_protocol_dialog": true,
      "external_protocol_dismiss_method": "auto",
      "strict_external_protocol_dismiss": false,
      "suppress_external_protocol_dialog": true,
      "use_persistent_browser_profile_for_webex": true,
      "chrome_user_data_dir": "artifacts/webex_chrome_profile",
      "blocked_external_protocol_schemes": [
        "webex",
        "wbx",
        "ciscospark",
        "webexteams",
        "webexapp",
        "webex-meetings",
        "cisco-webex"
      ],
      "protocol_handler_excluded_scheme_value": true,
      "verify_joined": true,
      "prejoin_timeout_ms": 30000,
      "joined_timeout_ms": 45000,
      "optional_selector_timeout_ms": 1000,
      "trust_click_state_after_unverified_action": false,
      "allow_unverified_fallback": false,
      "selectors": {
        "browser_join": [
          "button:has-text(\"Join from your browser\")",
          "a:has-text(\"Join from your browser\")",
          "button:has-text(\"Join from this browser\")",
          "button:has-text(\"Continue in browser\")",
          "button:has-text(\"Continue in this browser\")",
          "button:has-text(\"Join from browser\")",
          "button:has-text(\"Use web app\")",
          "button:has-text(\"Use browser\")",
          "button:has-text(\"Open in browser\")",
          "button:has-text(\"Join using browser\")",
          "button:has-text(\"브라우저에서 참여\")",
          "button:has-text(\"브라우저에서 참가\")",
          "button:has-text(\"이 브라우저에서 참여\")",
          "button:has-text(\"이 브라우저에서 참가\")",
          "button:has-text(\"브라우저로 참여\")",
          "button:has-text(\"브라우저로 참가\")",
          "button:has-text(\"웹에서 참여\")",
          "button:has-text(\"웹에서 참가\")",
          "button:has-text(\"웹 앱 사용\")",
          "button:has-text(\"앱 없이 참여\")",
          "button:has-text(\"앱 없이 참가\")"
        ],
        "continue_in_browser": [
          "button:has-text(\"Continue in browser\")",
          "button:has-text(\"Continue in this browser\")",
          "a:has-text(\"Continue in browser\")",
          "button:has-text(\"브라우저에서 계속\")"
        ],
        "cancel_open_app_prompt": [
          "button:has-text(\"Cancel\")",
          "button:has-text(\"Not now\")",
          "button:has-text(\"취소\")"
        ],
        "cookie_accept": [
          "button:has-text(\"Accept all\")",
          "button:has-text(\"Accept\")",
          "button:has-text(\"수락\")"
        ],
        "cookie_reject": [
          "button:has-text(\"Reject all\")",
          "button:has-text(\"Reject\")",
          "button:has-text(\"거절\")"
        ],
        "cookie_close": [
          "[data-test*=\"cookie\"] button[aria-label*=\"Close\" i]",
          "[data-test*=\"cookie\"] button[aria-label*=\"닫기\" i]",
          "button[aria-label=\"Close\"]",
          "button[aria-label=\"닫기\"]"
        ],
        "guest_join": [
          "button:has-text(\"Join as a guest\")",
          "button:has-text(\"Continue as guest\")"
        ],
        "name_input": [
          "input[name=\"displayName\"]",
          "input[name*=\"name\" i]",
          "input[aria-label*=\"name\" i]",
          "input[placeholder*=\"name\" i]",
          "input[placeholder*=\"Your name\" i]",
          "input[aria-label*=\"이름\" i]",
          "input[placeholder*=\"이름\" i]",
          "input[aria-label*=\"참가자\" i]",
          "input[placeholder*=\"참가자\" i]",
          "input[aria-label*=\"이름을 입력\" i]",
          "input[placeholder*=\"이름을 입력\" i]"
        ],
        "email_input": [
          "input[type=\"email\"]",
          "input[name=\"email\"]"
        ],
        "password_input": [
          "input[type=\"password\"]",
          "input[name=\"password\"]"
        ],
        "join_button": [
          "button:has-text(\"Join meeting\")",
          "button:has-text(\"Join\")",
          "button:has-text(\"미팅 참여\")",
          "button:has-text(\"회의 참여\")",
          "button:has-text(\"참여\")",
          "button:has-text(\"참가\")",
          "button:has-text(\"미팅 시작\")",
          "button:has-text(\"회의 시작\")"
        ],
        "joined": [
          "[aria-label*=\"Leave meeting\"]",
          "button:has-text(\"Leave\")"
        ],
        "mic_on_indicator": [
          "role=button[name=/Mute/i]",
          "role=button[name=/Mute microphone/i]",
          "[aria-label*=\"Mute\"]",
          "role=button[name=/음소거/]",
          "[aria-label*=\"마이크 음소거\"]"
        ],
        "mic_off_indicator": [
          "role=button[name=/Unmute/i]",
          "role=button[name=/Unmute microphone/i]",
          "[aria-label*=\"Unmute\"]",
          "role=button[name=/음소거 해제/]",
          "[aria-label*=\"마이크 음소거 해제\"]"
        ],
        "camera_on_indicator": [
          "role=button[name=/Stop video/i]",
          "role=button[name=/Turn off camera/i]",
          "[aria-label*=\"Stop video\"]",
          "role=button[name=/비디오 중지/]",
          "[aria-label*=\"카메라 끄기\"]"
        ],
        "camera_off_indicator": [
          "role=button[name=/Start video/i]",
          "role=button[name=/Turn on camera/i]",
          "[aria-label*=\"Start video\"]",
          "role=button[name=/비디오 시작/]",
          "[aria-label*=\"카메라 켜기\"]"
        ],
        "prejoin_mic_on_indicator": [
          "role=button[name=/Mute/i]",
          "role=button[name=/Mute microphone/i]",
          "[aria-label*=\"Mute\"]",
          "role=button[name=/음소거/]",
          "[aria-label*=\"마이크 음소거\"]"
        ],
        "prejoin_mic_off_indicator": [
          "role=button[name=/Unmute/i]",
          "role=button[name=/Unmute microphone/i]",
          "[aria-label*=\"Unmute\"]",
          "role=button[name=/음소거 해제/]",
          "[aria-label*=\"마이크 음소거 해제\"]"
        ],
        "prejoin_camera_on_indicator": [
          "role=button[name=/Stop video/i]",
          "role=button[name=/Turn off camera/i]",
          "[aria-label*=\"Stop video\"]",
          "role=button[name=/비디오 중지/]",
          "[aria-label*=\"카메라 끄기\"]"
        ],
        "prejoin_camera_off_indicator": [
          "role=button[name=/Start video/i]",
          "role=button[name=/Turn on camera/i]",
          "[aria-label*=\"Start video\"]",
          "role=button[name=/비디오 시작/]",
          "[aria-label*=\"카메라 켜기\"]"
        ],
        "screen_share_button": [
          "role=button[name=/Share content/i]",
          "role=button[name=/Share screen/i]",
          "[aria-label*=\"Share\"]",
          "role=button[name=/화면 공유/]",
          "role=button[name=/콘텐츠 공유/]",
          "[aria-label*=\"공유\"]"
        ],
        "screen_share_on_indicator": [
          "role=button[name=/Stop sharing/i]",
          "text=/You are sharing/i",
          "[aria-label*=\"Stop sharing\"]",
          "role=button[name=/공유 중지/]",
          "text=/공유하고 있습니다/"
        ],
        "screen_share_stop": [
          "role=button[name=/Stop sharing/i]",
          "[aria-label*=\"Stop sharing\"]",
          "role=button[name=/공유 중지/]",
          "[aria-label*=\"공유 중지\"]"
        ]
      },
      "fallback": {
        "enabled": false,
        "mic_key": "ctrl+shift+m",
        "camera_key": "ctrl+shift+v",
        "screen_share_key": "ctrl+shift+s",
        "leave_key": "alt+q",
        "coordinates": {
          "mic": null,
          "camera": null,
          "screen_share": null,
          "leave": null
        }
      }
    }
  },
  "clients": [
    {
      "name": "bot1",
      "host": "10.0.1.21",
      "c2_port": 8001,
      "display": ":99",
      "video_device": "/dev/video5",
      "sink_name": "VTC_Speaker",
      "source_name": "VTC_Microphone",
      "sink_description": "VTC_Speaker",
      "source_description": "VTC_Microphone",
      "microphone_name": "VTC_Microphone"
    }
  ]
}
