{
  "service": "jitsi_electron",
  "vtc_url": "https://172.31.32.200:8443/testroom#config.startWithAudioMuted=true&config.startWithVideoMuted=false",
  "duration": 5,
  "videoconference": true,
  "branch": "jitsi",
  "run_id": "icsi-jitsi-3bot-5min",
  "repo": {
    "dir": "/home/ubuntu/project/VTC-traffic-generator",
    "url": "https://github.com/thdud7/VTC-traffic-generator.git",
    "version": "jitsi",
    "python": "python3"
  },
  "ansible": {
    "user": "ubuntu",
    "ssh_private_key_file": "~/.ssh/bootstrap.pem"
  },
  "jitsi_server": {
    "name": "jitsi-server",
    "host": "ec2-54-180-113-35.ap-northeast-2.compute.amazonaws.com",
    "dir": "/home/ubuntu/vtc-lab/jitsi-docker-jitsi-meet-aa76415",
    "start_command": "docker compose up -d",
    "update_repo": false,
    "wait_host": "127.0.0.1",
    "wait_port": 8443
  },
  "icsi_data": {
    "s3_uri": "s3://vtc-traffic-data/datasets/icsi/v1",
    "audio_s3_uri": "s3://vtc-traffic-data/icsi",
    "local_root": "/tmp/vtc-data/icsi",
    "meeting_id": "Bdb001"
  },
  "capture_upload": {
    "s3_uri": "s3://vtc-traffic-data/captures",
    "run_id": "icsi-jitsi-3bot-5min",
    "include_logs": true
  },
  "behavior": {
    "mode": "icsi",
    "icsi": {
      "corpus_root": "/tmp/vtc-data/icsi",
      "meeting_id": "Bdb001",
      "min_speaker_duration_sec": 1.0,
      "min_utterance_duration_sec": 0.05,
      "max_duration_sec": 300,
      "time_scale": 1.0,
      "connect_timeout_sec": 180,
      "connect_grace_sec": 5
    },
    "scenario": {
      "enabled": true,
      "min_interval_sec": 20,
      "max_interval_sec": 45,
      "screen_share_probability": 0.6,
      "camera_probability": 1.0,
      "mic_probability": 0.8
    }
  },
  "defaults": {
    "audio_path": "/home/ubuntu/project/VTC-traffic-generator/VTC_AV/VTC_audio_tracks",
    "voice_name": "male_1-en-US-Wavenet-I",
    "video_path": "/home/ubuntu/vtc_data/video/camera",
    "video_name": "class_5_6.mov",
    "executable_path": "/home/ubuntu/service/jitsi-electron/run-jitsi.sh",
    "icsi_audio_root": "/tmp/vtc-data/icsi/ICSI/Signals",
    "screen_share_window": {
      "enabled": true,
      "title": "VTC Share Window",
      "html_path": "/home/ubuntu/vtc_data/screen_share/share.html"
    },
    "packet_capture": {
      "enabled": true,
      "interface": "any",
      "output_dir": "/home/ubuntu/vtc_data/captures/local",
      "capture_filter": "not port 5900",
      "display_filter": null,
      "dumpcap_path": "dumpcap",
      "tshark_path": "tshark"
    },
    "adapter_config": {
      "display_backend": "xvfb",
      "ignore_certificate_errors": true,
      "camera_name": "VTC Bot Camera",
      "window_title_regex": "Jitsi Meet|testroom|jitsi",
      "accessibility_window_regex": "Jitsi Meet|testroom|jitsi",
      "launch_timeout_sec": 20,
      "action_timeout_sec": 10,
      "skip_device_selection": true,
      "initial_mic_enabled": false,
      "initial_camera_enabled": true,
      "initial_screen_sharing": false,
      "accessibility_names": {},
      "accessibility_roles": {},
      "coordinates": {
        "name_input": null,
        "join_button": null,
        "mic_button": null,
        "camera_button": null,
        "hangup_button": null,
        "device_settings_button": null,
        "screen_share_button": null,
        "screen_share_target": null,
        "screen_share_confirm": null
      }
    }
  },
  "clients": [
    {
      "name": "bot1",
      "host": "172.31.40.44",
      "c2_host": "172.31.40.44",
      "c2_port": 8001,
      "display": ":99",
      "video_device": "/dev/video5",
      "voice_name": "male_1-en-US-Wavenet-I"
    },
    {
